# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Development: leave True. Production: set to False (docker compose does this).
DEBUG=True

# Comma-separated. Production: your hostname, e.g. trip.203.0.113.5.sslip.io
ALLOWED_HOSTS=*

# Comma-separated, with scheme. Production: https://trip.203.0.113.5.sslip.io
CSRF_TRUSTED_ORIGINS=

# Optional overrides. Empty means use the project defaults.
DATABASE_PATH=
MEDIA_ROOT=

# Sessions. Blank keeps the cookie host-only (fine locally). In production set it
# to your domain with a leading dot so www and the apex share one session,
# e.g. .example.com
SESSION_COOKIE_DOMAIN=
# Optional session lifetime in seconds (default 90 days).
SESSION_COOKIE_AGE=

# Production only
SECURE_SSL_REDIRECT=True

# Docker compose: the hostname Caddy should serve and get a certificate for.
SITE_ADDRESS=
